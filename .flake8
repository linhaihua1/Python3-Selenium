# ==========================================================================
# flake8 配置 —— Python 代码静态检查（CI 的质量门禁之一）
# ==========================================================================
#
# 怎么用：
#     pip install -r requirements-dev.txt
#     python -m flake8                # 在工程根目录执行，自动读取本文件
#
# 为什么需要它：
#     这个工程由多人协作维护，风格不统一时 diff 里全是格式噪音，
#     真正的问题（未使用的变量、拼错的导入）反而看不见。
#     flake8 能在提交前把这些拦掉，成本极低。
#
# 与单元测试的分工：
#     flake8      查"写错了"（语法层面、未使用变量、导入错误）
#     单元测试     查"做错了"（逻辑不符合预期）
#     两者都在 Jenkins 里，flake8 更早、更快（秒级）
#
# 改本文件时注意：
#     放宽规则要写清楚理由。没有理由的放宽，半年后就没人敢收紧了。
# ==========================================================================

[flake8]
# 一行最长 120 字符。本工程中文注释较多，80 的默认值会让注释频繁折行、更难读。
max-line-length = 120

# 不检查的目录/文件：
#   .git / __pycache__      非源码
#   Common/HTMLTestReportCN.py  第三方中文版 HTML 报告模板，改动它没有意义
exclude =
    .git,
    __pycache__,
    .idea,
    Common/HTMLTestReportCN.py

# 全局放行的检查项（每一项都要有理由）：
extend-ignore =
    # E402 规定 import 必须写在文件最前面。但 run.py / entrance.py 必须先改
    # sys.path（把工程根塞进去）才能 import 到 Common 包，顺序不能调换。
    E402,
    # W503/W504 是二元运算符该断在行首还是行尾的老争论，PEP8 自身已不再强制；
    # 与本工程的写法（运算符留在上一行末尾）不冲突，直接关掉。
    W503,
    W504

# 按目录放宽的规则：
per-file-ignores =
    # 测试文件里为了可读性会写很长的断言消息（期望值 / 实际值一起打出来），
    # 折行反而看不出对比关系，所以这里不限制行长。
    tests/*:E501
