# ==========================================================================
#  配置模板（新人阅读顺序：第 0 个）
# ==========================================================================
#  【怎么用】
#      cp config.ini.example config.ini      # Windows: copy config.ini.example config.ini
#    然后按下面注释改成你自己的环境与账号。
#
#  【为什么要有这个模板】
#     真实的 config.ini 含明文账号密码，已被 .gitignore 排除、不入库。
#     仓库里只保留这份"占位值"模板，保证新人 clone 下来知道该填什么。
#     流水线上则完全不需要 config.ini —— 账号密码由 Jenkins 凭据注入环境变量，
#     地址由构建参数传入（见 docs/CI-CD接入指南.md）。
#
#  【环境变量覆盖规则（CI/CD 关键）】
#     任意配置项都可以被同名环境变量覆盖：UI_ + 段名 + _ + 键名（全大写）
#       [environment] url            ->  UI_ENVIRONMENT_URL
#       [testcase]    login_password ->  UI_TESTCASE_LOGIN_PASSWORD
#       [ci]          headless       ->  UI_CI_HEADLESS
#     环境变量优先于本文件。要整体关闭该机制：UI_ENV_OVERRIDE=false
#
#  【格式说明】
#     - 以 # 开头的是注释
#     - 键名区分大小写（Common/configOverWriter.py 特意关掉了自动小写转换）
#     - 值里可以放心出现 %，解析器已关闭 % 插值，不会报错
#     - ★ 段头和键必须分行写，不能写成一行：
#           [ci]preflight = false          <- 错！这一整行被当成"段头 [ci]"
#           [ci]                             后半句被**静默丢弃**，
#           preflight = false              <- 对   于是 preflight 键根本不存在
#       ConfigParser 的段匹配正则没有整行锚定，所以这种写法既不报错也不生效，
#       排查起来非常费劲（曾经就因此让一个测试莫名去检查跑测机器的驱动版本）。
#       同一坑位还包括 [environment]url = xxx 这类写法。
# ==========================================================================


# --------------------------------------------------------------------------
# 被测环境：Common/basePage.open_browser() 会读这两项
# --------------------------------------------------------------------------
[environment]
# 被测系统入口地址（登录页）
# ⚠️ 建议指向测试环境；指向生产环境时跑全量用例会真实上传/报送数据
url = http://测试环境地址/sso-portal/#/?redirect=/launch
# 浏览器类型：chrome / firefox / edge
# 无需手动下载 driver —— Selenium 4 自带的 Selenium Manager 会自动匹配
browser = chrome


# --------------------------------------------------------------------------
# 【接口层测试】测试金字塔的底层（Common/apiClient.py 读取）
#   能用接口验证的，不要用 UI 验证 —— UI 层慢、脆、贵。
#   接口层该覆盖：字段校验、边界值、权限、状态流转、错误码。
#
#   ★ 没配 base_url 时，接口层用例会自动**跳过**（不会红）：
#     很多团队先上 UI 自动化、接口自动化后补，不该因为"还没配"就一片红。
#   对应环境变量：UI_API_BASE_URL 等（UI_ + 段 + 键，全大写）
# --------------------------------------------------------------------------
[api]
# 接口根地址。留空 = 不跑接口层用例
base_url =
# 登录接口路径
login_path = /api/login
# 登录返回里令牌的字段路径，支持嵌套写法（如 data.token / result.access_token）
token_field = token
# 健康检查接口路径（可选）。配了就会有一条"服务可用"的最快检查
health_path =
# 素材/列表类接口路径（可选，供样例用例改写）
list_path =
# 接口超时（秒）
timeout = 30


# --------------------------------------------------------------------------
# 【安全守卫】防止误连生产环境 —— 本工程优先级最高的一组配置
#   实现见 Common/env_guard.py，在执行用例之前检查，不通过就中止（退出码 2）。
#   它拦的是自动化最贵的一类事故：本想打测试环境，结果在生产上真上传、真报送。
#   对应环境变量：UI_SAFETY_GUARD / UI_SAFETY_URL_MUST_MATCH 等
# --------------------------------------------------------------------------
[safety]
# 总开关。false 会跳过下面所有检查（不推荐，除非你非常清楚在做什么）
guard = true

# 地址白名单（正则）。填了就必须匹配，否则中止。留空则不校验。
# 这是最有效的一道防线：只要写对一条正则，就再也不可能打到别的环境去。
# 例（只允许本工程的测试环境）：
#     url_must_match = ^http://test\.example\.com/
# 注意：正则里的点号和斜杠要转义，写不对会直接报"不是合法正则"并中止
url_must_match =

# 地址里出现任一关键字，即视为"疑似生产环境"（逗号或换行分隔）。
# 命中后会做两件事：只读用例放行并告警；含写用例则直接拦截。
# 留空则使用内置默认值：prod / production / 线上 / 正式 / 生产
url_blocklist =

# 是否允许在生产特征的环境下执行**写操作用例**（上传/报送/保存）。
#   false（默认，安全）—— 生产环境只跑只读用例，写用例一律拦下
#   true             —— 明确知道后果并接受，才会设成 true
# 对应环境变量：UI_SAFETY_ALLOW_WRITE
allow_write = false


# --------------------------------------------------------------------------
# 【多环境】一套代码在 dev / test / prod 之间切换
#   用法：python run.py --env test
#   原理：把 [env_名称] 段里的键翻译成环境变量覆盖，再走统一优先级链路
#        （环境变量 > config.ini > 代码默认值）。
#   段里**只写需要覆盖的项**，没写的沿用全局配置。
#   可写键：url / browser / headless / mode / allow_write / pattern
#     mode = readonly  该环境只跑只读用例（CI 上的推荐姿态）
#     mode = all       不限（本机调试用）
#   对应环境变量：UI_ENVIRONMENT_URL / UI_TESTCASE_MODE 等
# --------------------------------------------------------------------------
[env_test]
# 测试环境：无头跑 + 只跑只读用例，适合每次提交都跑一遍
# （地址请改成你们真实的测试环境地址；占位地址会被环境守卫拦下）
url = http://测试环境地址/sso-portal/#/?redirect=/launch
headless = true
mode = readonly

# 开发环境：开发者本地联调用，通常有界面、不限读写（自己造的数据自己清理）
# [env_dev]
# url = http://开发环境地址/sso-portal/#/?redirect=/launch
# headless = false
# mode = all

# 预发环境：上线前的最后一道演练。地址接近生产，默认仍只读；
# 确需验证写流程时，单独把 mode 改成 all 并显式 allow_write = true。
# [env_staging]
# url = http://预发环境地址/sso-portal/#/?redirect=/launch
# headless = true
# mode = readonly

# 生产环境的配置档。默认注释掉 —— 需要时再取消注释，避免"手滑 --env prod"。
# 生产环境**必须**保持 mode = readonly，写用例永远不要在生产跑。
# （代码层也做了硬保险：--env prod 会被 run.py 强制只读，见 enforce_prod_safety）
# [env_prod]
# url = http://生产环境地址/sso-portal/#/?redirect=/launch
# headless = true
# mode = readonly


# --------------------------------------------------------------------------
# 用例参数：TestSuites/*.py 的 setUpClass 与用例方法会读这里
# 把账号和文件路径放在配置里，是为了换环境/换账号时不用改代码
#
# ★ 本段与 [assert] 段的键都是**必填**的：缺失时用例会在浏览器打开之前
#   直接报错中止，并打印"该去 config.ini 哪一段补哪个键"。
#   代码里刻意不留默认值—— 拿上一个系统的值去比对会产出误导性的断言失败。
# --------------------------------------------------------------------------
[testcase]
# 登录账号（流水线上由 Jenkins 凭据注入，不在这里填真实值）
login_username = your_username
login_password = your_password

# 待上传的文件：写绝对路径，也支持 ~/video/demo.mp4 这种用户目录写法。
# 文件不存在时，"上传"用例会直接失败并提示路径（只读冒烟子集不涉及此用例）。
upload_file = D:\videos\demo.mp4

# 上传实现方式：
#   send_keys  默认。直接给页面里隐藏的 input[type=file] 赋值，不弹系统对话框，
#              速度快、可在无桌面环境的 CI 上运行，推荐
#   autoit     点上传按钮弹出 Windows「打开」对话框，用 autoit 模拟键盘输入。
#              需要 pip install PyAutoIt，且系统对话框标题必须是「打开」（中文系统）
# 说明：send_keys 失败时会自动回退到 autoit，通常不用手动改这一项
upload_mode = send_keys

# ---- 上传表单的字段值（按你系统的实际表单增删、改名）----
# 用例里用 Config.get_form_field('键名') 读；缺哪个就在跑到那条用例时报错说明。
# ⚠️ 不要在代码里留兜底默认值 —— 详见 Common/config.py 的 get_form_field。
video_author = your_username
phone = 13000000000
reporting = 请填写上报单位

# 查询关键字（用例 test_5keyword 搜索的关键词）
# 对应环境变量：UI_TESTCASE_QUERY_KEYWORD
query_keyword = 请填写查询关键字

# 报送用例（test_6submitted）要选择的审核人姓名。
# ★ 按**姓名**定位下拉项，不要写「列表第 N 项」——
#   写死序号的话，人员列表顺序一变就会静默选错人：不报错、用例还是绿的，
#   属于最难发现的一类缺陷。姓名填配置环境里任意一位真实审核人。
# 对应环境变量：UI_TESTCASE_FIRST_TRIAL_PERSON
first_trial_person = 请填写审核人姓名

# 写入范围：控制本次允许跑哪些用例。
#   all      不限（默认，本机调试用）
#   readonly 只跑只读用例，写操作（上传/报送/保存）会被自动跳过
# 判断依据是用例上的作用域标记，见 Common/testcase_meta.py：
#   类属性 scope = 'readonly'  或  方法上加 @readonly
# 未被标记的用例一律算写用例（刻意的失败安全设计：忘了标最多跑不了，
# 反过来若默认只读，忘了标的写用例就会直接放到生产上跑）。
# 对应环境变量：UI_TESTCASE_MODE
mode = all

# 是否在用例结束后自动清理其创建的数据（造数/清数治理，见 Common/dataGovernance.py）。
#   true   用例 tearDown 时执行已登记的清理（默认，推荐）
#   false  不清理，保留现场（调试失败原因时临时用）
# 继承 IsolatedTestCase 的用例才会用到；清理失败只记日志，不影响用例结果。
# 对应环境变量：UI_TESTCASE_AUTO_CLEANUP
auto_cleanup = true


# --------------------------------------------------------------------------
# 断言期望值：用例靠校验页面标题判定成功与否。
#
# ★★ 本段的每一个键都是必填，且**刻意不留代码默认值** ★★
#   原因：换系统后忘了改配置，框架会拿着上一个系统的标题去比对，
#   报出「期望[旧系统标题] 实际[新系统标题]」这种完全看不出原因的失败，
#   真实原因（配置没跟着换）被彻底掩盖。缺失时直接报错更安全。
#
#   报错形式：缺少必填配置 [assert] title_login（登录后首页标题）。
#             1. 在 config.ini 的 [assert] 段补上  title_login = 实际值
#             2. 设置环境变量：set UI_ASSERT_TITLE_LOGIN=实际值
#             3. python run.py --env 档位名
#
#   代码里的读取方式一律是必填读取（缺失即报错，不给默认值）：
#       Config.get_assert_value('title_login')   读本段
#       Config.get_form_field('phone')          读 [testcase] 段的表单字段
#   详见 Common/config.py 的 get_required / get_required_list。
#
#   换被测系统时只改这三行，一行 .py 都不用动。
#   对应环境变量：UI_ASSERT_XXX（UI_ + 段 + 键，全大写）
# --------------------------------------------------------------------------
[assert]
# 登录成功后首页的标题
title_login = 请填写登录后标题
# 进入业务系统工作台后的标题
title_workbench = 请填写工作台标题
# 进入素材库/业务页后的标题（上传/查询/报送用例也用它校验"页面未跳走"）
title_material = 请填写业务页标题


# --------------------------------------------------------------------------
# 【系统适配】接入任意主流 Web 系统的关键（PageObject/genericPage.py 读取）
#   本框架可适配党政 / 财务 / ERP / 商城 / 数据中台等绝大多数 Web 系统。
#   方法一（推荐，零代码）：用 GenericPage，只靠本 [system] 段的「文案特征」
#           定位元素 —— 用户名/密码框的 placeholder、登录按钮文字、成功标识。
#           换系统只改这里，不改任何代码。
#   方法二（复杂系统）：为该系统新建 PageObject/xxxPage.py + elementPage，
#           复用 Common/basePage.py 的全部通用能力（含跨系统通用方法）。
#   对应环境变量：UI_SYSTEM_USERNAME_PLACEHOLDER 等（UI_ + 段 + 键，全大写）
# --------------------------------------------------------------------------
[system]
# 用户名输入框的占位提示文案（placeholder）。登录页那个灰色提示文字。
username_placeholder = 请输入用户名
# 密码输入框的占位提示文案
password_placeholder = 请输入密码
# 登录按钮上显示的文字（click_by_text 按它点击；找不到会自动回车提交）
login_button_text = 登录
# 登录成功后页面上必然出现的文字，用来等登录完成。如「退出」「工作台」「首页」。
# 留空则改为等加载遮罩消失。
success_text =
# 元素定位默认超时（秒），与 [ci] element_timeout 保持一致即可
element_timeout = 15


# --------------------------------------------------------------------------
# 报告元信息：Common/runner.py 读取；命令行参数优先级高于这里
# --------------------------------------------------------------------------
[report]
# ★ 报告名称也属于业务数据：不要把具体系统名写进来，否则换系统后
#   报告标题会误导人。保持中性，或用 --title / --filename 临时指定。
title = UI 自动化测试报告
filename = UI自动化测试报告.html
tester = ui-auto
description = Web UI 自动化测试


# --------------------------------------------------------------------------
# CI/CD 流水线相关：Common/basePage.py、Common/runner.py 读取
# 本机开发保持默认即可；Jenkins 上用环境变量覆盖
# --------------------------------------------------------------------------
[ci]
# 是否无头运行（不开浏览器界面）
#   false 本机开发用，能看见浏览器在操作，便于调试
#   true  流水线必须开！Jenkins 节点没有桌面环境，有头模式起不来
# 对应环境变量：UI_CI_HEADLESS
headless = false

# Selenium Grid 远程执行 Hub 地址。留空表示本机开浏览器（默认）。
# 填了就把驱动交给远程 Hub，由 Hub 调度到各节点浏览器执行（容器化/多浏览器并行必用）。
# 例：http://127.0.0.1:4444  或命令行 --grid http://hub:4444
# 对应环境变量：UI_CI_GRID_URL
grid_url =

# 元素定位默认超时（秒）。CI 机器通常比开发机慢，定位不稳时可调到 30
# 对应环境变量：UI_CI_ELEMENT_TIMEOUT
element_timeout = 15

# 隐式等待（秒）。影响 find_element 的轮询时长
# 对应环境变量：UI_CI_IMPLICIT_WAIT
implicit_wait = 5

# 冒烟用例：只跑这些用例（按用例方法名匹配，逗号分隔，支持部分匹配）
# 选取原则：**不产生数据副作用**的前缀用例。
# 当前 6 条用例是一条串行业务流，后 3 条会真实上传视频、提交报送单，
# 所以冒烟只取前 3 条 —— 验证"登录链路 + 页面加载"是否正常。
# 用法：python run.py --suite smoke
smoke_cases = test_1login,test_2select_scxt,test_3material

# 操作失败自动重试次数（应对元素过期/渲染慢/点击被挡等偶发失败，降低 flaky）。
# BasePage.safe_click / safe_type 会用到；0 表示不重试。
# 对应环境变量：UI_CI_RETRY_TIMES
retry_times = 2

# JUnit XML 结果文件路径（相对工程根目录）
# Jenkins 的 junit 插件靠它判定构建成功/失败，**不要删**
# 对应环境变量：UI_CI_JUNIT_XML
junit_xml = Report/junit-results.xml

# 失败自动取证：用例失败时自动保存截图 + 页面源码（见 Common/failureCapture.py）。
# 关掉后 CI 上的失败就只能靠人工重放，强烈建议保持 true。
# 对应环境变量：UI_CI_ARTIFACTS
artifacts = true

# 取证文件的存放目录（相对工程根目录），实际会再拼一层日期子目录，
# 例如 Report/artifacts/2026-10-06/。
# 放在 Report/ 下是为了 CI 只归档一个目录就够（见 Jenkinsfile 的 archiveArtifacts）
# 对应环境变量：UI_CI_ARTIFACTS_DIR
artifacts_dir = Report/artifacts

# 额外的 Chrome 启动参数（逗号分隔），一般留空
# 对应环境变量：UI_CI_EXTRA_CHROME_ARGS
extra_chrome_args =

# Chrome 可执行文件的绝对路径。留空 = 用系统默认位置（Windows/macOS 本机不用填）。
# 容器镜像（见仓库根 Dockerfile）里 chromium 装在 /usr/bin/chromium，需要显式指定
# 对应环境变量：UI_CI_CHROME_BINARY
chrome_binary =

# 运行环境自检：执行用例前先检查 Python / selenium / 浏览器 / 驱动版本 / 目录可写，
# 有致命问题就中止（退出码 2），不会打开浏览器。
# 见 Common/preflight.py。单独体检：python run.py --preflight
# 遇到过的真实故障：PATH 上有个旧版 chromedriver，与 Chrome 版本不匹配，
# 现象是"卡 60 秒 + 一屏堆栈"，而自检 1 秒就能说清是驱动版本问题。
# 对应环境变量：UI_CI_PREFLIGHT
preflight = true


# --------------------------------------------------------------------------
# 邮件发件人：Common/sentMail.py 读取（需要用 --mail 发报告时才配）
# password 填 SMTP 授权码（去 QQ 邮箱「设置-账户」开启 SMTP 服务后生成），
# 注意不是 QQ 登录密码！
# smtp_host / smtp_port 不填时，默认按 QQ 邮箱（smtp.qq.com:465，SSL）处理；
# 用其它邮箱（如 163 / 企业邮箱）时改成对应服务器与端口即可。
# 对应环境变量：UI_SENDER_SMTP_HOST / UI_SENDER_SMTP_PORT
# --------------------------------------------------------------------------
[sender]
username = 发件人
email = 发件人邮箱
password = SMTP授权码
smtp_host = smtp.qq.com
smtp_port = 465


# --------------------------------------------------------------------------
# 邮件收件人：键名随便写（只做标识），值是收件邮箱
# 需要发给多个人，再加几行即可 —— sentMail 会遍历本段下所有键
# --------------------------------------------------------------------------
[addressed]
收件人姓名 = 收件人邮箱


# --------------------------------------------------------------------------
# 群机器人通知（run.py --notify 时使用）：钉钉 / 企业微信 / 通用 webhook
#   跑完把结果推送到群，不用打开 Jenkins 也能第一时间知道成败。
#   对应环境变量：UI_NOTIFY_WEBHOOK / UI_NOTIFY_SECRET / UI_NOTIFY_TITLE
# --------------------------------------------------------------------------
[notify]
# 机器人 webhook 地址（钉钉/企业微信机器人设置里复制）；不填则 --notify 不推送
webhook =
# 钉钉机器人若开启了「加签」安全设置，把密钥填这里；没开启加签则留空
secret =
# 推送消息的标题前缀
title = UI 自动化测试


# --------------------------------------------------------------------------
# 多系统配置：一套框架管理多个被测系统。
#   每个系统建一个 [system_名称] 段，用 python run.py --system 名称 一键切换。
#   可用键：url / browser / username / password / headless / pattern(用例文件名匹配)
#   没写的键沿用全局配置；密码同样可用环境变量 UI_TESTCASE_LOGIN_PASSWORD 覆盖。
#   下面是两个示例，按需复制修改。
# --------------------------------------------------------------------------
# [system_erp]
# url = http://erp测试环境地址/login
# username = erp_tester
# password = your_erp_password
# pattern = testErp*.py
#
# [system_mall]
# url = http://商城测试环境/
# pattern = testMall*.py
